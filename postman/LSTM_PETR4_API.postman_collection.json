        {
          "name": "Predict - Erro: dias_futuros fora do intervalo (422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"{{symbol}}\",\n  \"dias_futuros\": 50\n}"
            },
            "url": { "raw": "{{base_url}}/predict", "host": ["{{base_url}}"], "path": ["predict"] },
            "description": "dias_futuros aceita apenas valores entre 1 e 30; fora disso o FastAPI/Pydantic retorna 422 (erro de validação)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
