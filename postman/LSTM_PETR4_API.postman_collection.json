    {
      "name": "Predição",
      "item": [
        {
          "name": "Predict - Automático (Yahoo Finance)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"{{symbol}}\",\n  \"dias_futuros\": 5\n}"
            },
            "url": { "raw": "{{base_url}}/predict", "host": ["{{base_url}}"], "path": ["predict"] },
            "description": "Busca automaticamente os últimos preços via Yahoo Finance e prevê os próximos N dias."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retornou 5 predições', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.predicoes).to.have.lengthOf(5);",
                  "  pm.expect(json.modelo_info.fonte_dados).to.eql('yahoo_finance');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Predict - Com preços históricos do usuário",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"{{symbol}}\",\n  \"dias_futuros\": 3,\n  \"precos_historicos\": [35.10, 35.22, 35.05, 35.40, 35.60, 35.55, 35.70, 35.80, 36.00, 35.95, 36.10, 36.25, 36.15, 36.30, 36.45, 36.50, 36.40, 36.60, 36.75, 36.80, 36.90, 37.00, 36.95, 37.10, 37.20, 37.15, 37.30, 37.40, 37.35, 37.50, 37.60, 37.55, 37.70, 37.80, 37.75, 37.90, 38.00, 37.95, 38.10, 38.20, 38.15, 38.30, 38.40, 38.35, 38.50, 38.60, 38.55, 38.70, 38.80, 38.75, 38.90, 39.00, 38.95, 39.10, 39.20, 39.15, 39.30, 39.40, 39.60, 39.80]\n}"
            },
            "url": { "raw": "{{base_url}}/predict", "host": ["{{base_url}}"], "path": ["predict"] },
            "description": "Usa uma lista de preços fornecida manualmente (mínimo 60 valores, do mais antigo ao mais recente) em vez de buscar no Yahoo Finance."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Fonte de dados é o usuário', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.modelo_info.fonte_dados).to.eql('fornecido_pelo_usuario');",
                  "  pm.expect(json.predicoes).to.have.lengthOf(3);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
